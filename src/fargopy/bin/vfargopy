    def normalize_decimal(self, lineedit):
        text = lineedit.text()
        if ',' in text:
            lineedit.setText(text.replace(',', '.'))

    def show_logo_on_canvas(self):
        self.figure.clear()
        ax = self.figure.add_subplot(111)
        ax.axis('off')
        ax.set_facecolor('#23272b')
        self.figure.set_facecolor('#23272b')
        import matplotlib.image as mpimg
        # Reuse the same multi-path resolution logic as in init_ui
        logo_path = None
        try:
            import pkg_resources
            candidate = pkg_resources.resource_filename('fargopy', 'data/fargopy_logo_white.png')
            if os.path.exists(candidate):
                logo_path = candidate
        except Exception:
            pass

        if logo_path is None:
            try:
                pkg_dir = os.path.dirname(fp.__file__)
                candidate = os.path.abspath(os.path.join(pkg_dir, '..', '..', 'gallery', 'fargopy_logo_white.png'))
                if os.path.exists(candidate):
                    logo_path = candidate
            except Exception:
                pass

        if logo_path is None:
            try:
                script_dir = os.path.dirname(__file__)
                candidate = os.path.abspath(os.path.join(script_dir, '..', '..', '..', '..', 'gallery', 'fargopy_logo_white.png'))
                if os.path.exists(candidate):
                    logo_path = candidate
            except Exception:
                pass

        try:
            if logo_path and os.path.exists(logo_path):
                try:
                    img = mpimg.imread(logo_path)
                    if img is None:
                        raise RuntimeError("mpimg.imread returned None")
                    ax.imshow(img, aspect='auto')
                except Exception as e:
                    print(f"Warning: could not read logo image '{logo_path}': {e}")
                    ax.text(0.5, 0.5, "FARGOpy", fontsize=40, ha='center', va='center', color='white')
            else:
                print(f"Warning: logo file not found at any candidate locations")
                ax.text(0.5, 0.5, "FARGOpy", fontsize=40, ha='center', va='center', color='white')
        except Exception as e:
            print(f"Warning: unexpected error showing logo: {e}")
            ax.text(0.5, 0.5, "FARGOpy", fontsize=40, ha='center', va='center', color='white')
        self.canvas.draw()

    def select_simulation_path(self):
        path = QFileDialog.getExistingDirectory(self, "Select simulation output directory")
        if path:
            self.path_line.setText(path)
            self._safe_call("Loading simulation", self.load_simulation, path)

    def load_simulation(self, path):
        self._loading_simulation = True
        self.sim = fp.Simulation(output_dir=path)
        # self.sim.units('CGS')  # <-- Remove this line, respeta las unidades originales

        # Detect coordinate system — be defensive if simulation properties
        coord = 'spherical'
        try:
            if hasattr(self.sim, 'vars') and self.sim.vars is not None:
                coord = getattr(self.sim.vars, 'COORDINATES', coord)
            else:
                # Try explicitly loading properties if available
                if hasattr(self.sim, 'load_properties'):
                    try:
                        self.sim.load_properties()
                        if hasattr(self.sim, 'vars') and self.sim.vars is not None:
                            coord = getattr(self.sim.vars, 'COORDINATES', coord)
                    except Exception:
                        pass
        except Exception:
            coord = 'spherical'

        self.coord_system = str(coord).lower()
        is_polar_2d = self._is_polar_2d()

        # If properties weren't loaded correctly, bail out and keep UI disabled
        if not hasattr(self.sim, 'vars') or getattr(self.sim, 'vars', None) is None or not hasattr(self.sim, 'domains') or getattr(self.sim, 'domains', None) is None:
            try:
                self._append_log('Simulation variables or domains not found; UI controls disabled.', level='error')
            except Exception:
                print('Simulation variables or domains not found; UI controls disabled.')
            for w in [getattr(self, 'time_slider', None), getattr(self, 'res_slider', None), getattr(self, 'interp_toggle', None), getattr(self, 'streamlines_toggle', None), getattr(self, 'update_button', None), getattr(self, 'play_snap_button', None), getattr(self, 'pause_snap_button', None), getattr(self, 'reset_snap_button', None), getattr(self, 'hill_planet_combo', None), getattr(self, 'field_dropdown', None), getattr(self, 'map_dropdown', None)]:
                try:
                    if w is not None:
                        w.setEnabled(False)
                except Exception:
                    pass
            return

        # Update UI based on coordinate system
        self._configure_coordinate_controls()
        if is_polar_2d:
            self.slice_type = 'phi'
        elif self.coord_system == 'cylindrical':
            self.slice_type = 'z'
        else:
            self.slice_type = 'theta'
        
        self.time_slider.setEnabled(True)
        self.time_slider.setMinimum(0)
        try:
            nsnaps = int(self.sim._get_nsnaps())
            self.time_slider.setMaximum(max(nsnaps - 1, 0))
            # Ensure slider has a valid value
            self.time_slider.setValue(min(1, max(nsnaps - 1, 0)))
        except Exception:
            # Simulation not fully populated; set defaults and keep UI usable
            self.time_slider.setMaximum(0)
            self.time_slider.setValue(0)
        self.r_min.setText("")
        self.r_max.setText("")
        
        # Set initial coordinate values based on coordinate system
        if is_polar_2d:
            self.theta_min.setText("")
            self.theta_max.setText("")
            self.phi_min.setText("")
            self.phi_max.setText("")
        elif self.coord_system == 'cylindrical':
            try:
                z_val = self._format_angle(0.0)
                self.theta_min.setText(z_val)
            except Exception:
                self.theta_min.setText("0.0")
            self.last_slice_str = f"z={self.theta_min.text()}"
        else:  # spherical
            theta_domain = getattr(self.sim.domains, 'theta', None)
            if theta_domain is not None:
                theta_val = self._format_angle(theta_domain.max())
                self.theta_min.setText(theta_val)
                self.last_slice_str = f"theta={theta_val}"
            else:
                self.theta_min.setText("")
                self.last_slice_str = ""
        
        self.theta_max.setText('')
        self.phi_min.setText("")
        self.phi_max.setText("")
        if self.coord_system != 'spherical' or is_polar_2d:
            self.last_slice_str = ""
        for edit in [self.r_min, self.r_max, self.theta_min, self.theta_max, self.phi_min, self.phi_max]:
            edit.setEnabled(True)
        if self._is_polar_2d():
            self.theta_min.setEnabled(False)
            self.theta_max.setEnabled(False)
            self.slice_type_combo.setEnabled(False)
        self.res_slider.setEnabled(True)
        self.interp_toggle.setEnabled(True)
        self.streamlines_toggle.setEnabled(True)
        self.density_slider.setEnabled(True)
        self.hill_frac_slider.setEnabled(True)
        self.show_circle_toggle.setEnabled(True)
        try:
            self.hill_planet_combo.clear()
            planets = self.sim.load_planets(snapshot=self.time_slider.value())
            for i, planet in enumerate(planets):
                name = getattr(planet, "name", f"Planet {i + 1}")
                self.hill_planet_combo.addItem(f"{i}: {name}", i)
            self.hill_planet_combo.setEnabled(len(planets) > 0)
        except Exception:
            self.hill_planet_combo.clear()
            self.hill_planet_combo.setEnabled(False)
        self.reflect_button.setEnabled(True)
        self.update_button.setEnabled(True)
        self.home_button.setEnabled(True)
        self.play_snap_button.setEnabled(True)
        self.pause_snap_button.setEnabled(True)
        self.reset_snap_button.setEnabled(True)
        self.info_button.setEnabled(True)
        # Update snapshot limits in the dialog
        self.fixed_cbar_snap_spin.setMaximum(self.sim._get_nsnaps()-1)
        self.fixed_cbar_snap_spin.setValue(1)
        self.fixed_cbar_limits = {}
        self.refresh_field_dropdown(preferred='gasdens')
        self.field_dropdown.setEnabled(True)
        self.map_dropdown.setEnabled(True)
        # Ensure default colormap is applied when a simulation is loaded
        try:
            self.cmap_dropdown.setCurrentText('inferno')
            self.stream_cmap_dropdown.setCurrentText('viridis_r')
        except Exception:
            pass
        self._append_log(f"Loaded simulation in {self.coord_system} mode")
        self._loading_simulation = False
        self.plot_density()

    def _restore_default_view_state(self):
        if not self.sim:
            return

        self._configure_coordinate_controls()
        if self._is_polar_2d():
            self.slice_type = 'phi'
            if hasattr(self, 'slice_type_combo'):
                self.slice_type_combo.blockSignals(True)
                self.slice_type_combo.setCurrentText('phi')
                self.slice_type_combo.blockSignals(False)
            self.r_min.setText("")
            self.r_max.setText("")
            self.theta_min.setText("")
            self.theta_max.setText("")
            self.phi_min.setText("")
            self.phi_max.setText("")
            self.theta_min.setEnabled(False)
            self.theta_max.setEnabled(False)
            self.slice_type_combo.setEnabled(False)
        elif self.coord_system == 'cylindrical':
            self.slice_type = 'z'
            if hasattr(self, 'slice_type_combo'):
                self.slice_type_combo.blockSignals(True)
                self.slice_type_combo.setCurrentText('z')
                self.slice_type_combo.blockSignals(False)
            self.r_min.setText("")
            self.r_max.setText("")
            self.theta_min.setText(self._format_angle(0.0))
            self.theta_max.setText("")
            self.phi_min.setText("")
            self.phi_max.setText("")
            self.theta_min.setEnabled(True)
            self.theta_max.setEnabled(True)
            self.slice_type_combo.setEnabled(True)
        else:
            self.slice_type = 'theta'
            if hasattr(self, 'slice_type_combo'):
                self.slice_type_combo.blockSignals(True)
                self.slice_type_combo.setCurrentText('theta')
                self.slice_type_combo.blockSignals(False)
            self.r_min.setText("")
            self.r_max.setText("")
            theta_domain = getattr(self.sim.domains, 'theta', None)
            if theta_domain is not None:
                self.theta_min.setText(self._format_angle(theta_domain.max()))
            else:
                self.theta_min.setText("")
            self.theta_max.setText("")
            self.phi_min.setText("")
            self.phi_max.setText("")
            self.theta_min.setEnabled(True)
            self.theta_max.setEnabled(True)
            self.slice_type_combo.setEnabled(True)

        self.last_slice_str = ""
        self._fields_edited = False

    def start_snapshot_playback(self):
        if not self.sim:
            return
        if self.time_slider.value() >= self.time_slider.maximum():
            self.time_slider.setValue(self.time_slider.minimum())
        self.snapshot_play_timer.start()

    def pause_snapshot_playback(self):
        if hasattr(self, 'snapshot_play_timer'):
            self.snapshot_play_timer.stop()

    def go_to_snapshot_zero(self):
        if not self.sim:
            return
        self.pause_snapshot_playback()
        self.time_slider.setValue(0)
        self.update_plot()

    def advance_snapshot_playback(self):
        if not self.sim:
            self.pause_snapshot_playback()
            return

        current = self.time_slider.value()
        last = self.time_slider.maximum()

        if current >= last:
            self.pause_snapshot_playback()
            return

        self.time_slider.setValue(current + 1)
        self.update_plot_fast()

    def update_plot_fast(self):
        """Playback-oriented update.

        The normal plotting path is still used to compute the new field for
        the current snapshot. If the plot state is compatible with the
        previous frame, _plot_density_impl updates the existing QuadMesh via
        set_array(). Otherwise it falls back to the full plot rebuild.
        """
        if self.render_cached_current_frame():
            return
        self._fast_update_requested = True
        try:
            self.plot_density()
        finally:
            self._fast_update_requested = False

    def plot_state_signature(self, slice_str=None):
        """Return a snapshot-independent signature of the current plot state.

        If this signature changes, the current Matplotlib artists may no
        longer be compatible with a fast set_array update and the full plot
        must be rebuilt.
        """
        try:
            selected_field = self.selected_field_name()
        except Exception:
            selected_field = ""
        if slice_str is None:
            try:
                slice_str = self.build_slice_str()
            except Exception:
                slice_str = ""
        return (
            selected_field,
            self.vel_dropdown.currentText() if hasattr(self, 'vel_dropdown') else '',
            str(slice_str or ''),
            int(self.res_slider.value()) if hasattr(self, 'res_slider') else None,
            bool(self.interp_toggle.isChecked()) if hasattr(self, 'interp_toggle') else False,
            self.cmap_dropdown.currentText() if hasattr(self, 'cmap_dropdown') else '',
            bool(self.fixed_cbar_enabled),
            int(self.fixed_cbar_snap_spin.value()) if hasattr(self, 'fixed_cbar_snap_spin') else None,
            bool(self.manual_vmin_vmax_enabled),
            float(self.manual_vmin),
            float(self.manual_vmax),
            self.length_scale_combo.currentText() if hasattr(self, 'length_scale_combo') else '',
            bool(self.auto_downsample_toggle.isChecked()) if hasattr(self, 'auto_downsample_toggle') else True,
            int(self.max_display_res_spin.value()) if hasattr(self, 'max_display_res_spin') else self.max_display_points,
            int(self.stream_display_res_spin.value()) if hasattr(self, 'stream_display_res_spin') else self.max_stream_points,
        )

    def can_use_fast_pcolormesh_update(self, signature, data_map):
        """Return True when playback can update only the existing QuadMesh.

        Streamlines, reflection overlays and Hill-radius artists are excluded
        from the fast path because they depend on vector fields or planet
        positions and should be regenerated snapshot by snapshot.
        """
        if not getattr(self, '_fast_update_requested', False):
            return False
        if getattr(self, '_main_pcm', None) is None:
            return False
        if getattr(self, '_last_plot_signature', None) != signature:
            return False
        if getattr(self, '_last_data_shape', None) != tuple(np.asarray(data_map).shape):
            return False
        if self.streamlines_toggle.isChecked():
            return False
        if getattr(self, 'reflect_enabled', False):
            return False
        if self.show_circle_toggle.isChecked():
            return False
        return True

    def _on_performance_options_changed(self):
        """Apply performance-control changes and redraw with the new LOD policy."""
        try:
            self.auto_downsample_enabled = bool(self.auto_downsample_toggle.isChecked())
            self.max_display_points = int(self.max_display_res_spin.value())
            self.max_stream_points = int(self.stream_display_res_spin.value())
            self.clear_plot_cache()
            if self.sim is not None:
                self.plot_density()
        except Exception as exc:
            self._handle_exception("Performance options", exc)

    def _on_cache_options_changed(self):
        try:
            self.plot_cache_enabled = bool(self.plot_cache_toggle.isChecked())
            self.plot_cache_max_items = int(self.plot_cache_size_spin.value())
            if not self.plot_cache_enabled:
                self.clear_plot_cache()
            else:
                self._trim_plot_cache()
        except Exception as exc:
            self._handle_exception("Cache options", exc)

    def clear_plot_cache(self):
        try:
            self._plot_cache.clear()
        except Exception:
            self._plot_cache = OrderedDict()

    def _simple_plot_cache_allowed(self):
        try:
            if hasattr(self, 'plot_cache_toggle') and not self.plot_cache_toggle.isChecked():
                return False
            if hasattr(self, 'streamlines_toggle') and self.streamlines_toggle.isChecked():
                return False
            if hasattr(self, 'show_circle_toggle') and self.show_circle_toggle.isChecked():
                return False
            if getattr(self, 'reflect_enabled', False):
                return False
            return True
        except Exception:
            return False

    def _plot_cache_key(self, signature=None, snapshot=None):
        try:
            if signature is None:
                signature = self.plot_state_signature()
            if snapshot is None:
                snapshot = int(self.time_slider.value())
            return (int(snapshot), signature)
        except Exception:
            return None

    def _put_plot_cache(self, key, entry):
        if key is None or not self._simple_plot_cache_allowed():
            return
        try:
            self._plot_cache[key] = entry
            self._plot_cache.move_to_end(key)
            self._trim_plot_cache()
        except Exception:
            pass

    def render_cached_current_frame(self):
        """Render a cached simple pcolormesh frame, if available.

        The cache is intentionally restricted to plots without streamlines,
        Hill-radius overlays or reflection overlays. Those artists have their
        own state and should be regenerated by the complete plotting path.
        """
        if not self._simple_plot_cache_allowed():
            return False
        key = self._plot_cache_key()
        if key is None:
            return False
        entry = self._plot_cache.get(key)
        if entry is None:
            return False
        try:
            self._plot_cache.move_to_end(key)
            X_plot = entry['X']
            Y_plot = entry['Y']
            data_map = entry['Z']
            cmap = entry['cmap']
            vmin = entry.get('vmin')
            vmax = entry.get('vmax')
            xlabel = entry.get('xlabel', 'X')
            ylabel = entry.get('ylabel', 'Y')
            cbar_label = entry.get('cbar_label', '')
            signature = entry.get('signature')

            self.figure.clear()
            ax = self.figure.add_subplot(111)
            ax.set_facecolor('white')
            self.figure.set_facecolor('white')
            pcm = ax.pcolormesh(X_plot, Y_plot, data_map, shading='auto', cmap=cmap, vmin=vmin, vmax=vmax)
            ax.set_xlabel(xlabel, fontsize=15, fontname='Serif')
            ax.set_ylabel(ylabel, fontsize=15, fontname='Serif')
            try:
                fp.Plot.fargopy_mark(ax)
            except Exception:
                pass
            try:
                cbar = self.figure.colorbar(pcm, ax=ax)
                cbar.set_label(cbar_label, fontsize=15, fontname='Serif')
            except Exception:
                cbar = None
            self._main_pcm = pcm
            self._main_cbar = cbar
            self._last_plot_signature = signature
            self._last_data_shape = tuple(np.asarray(data_map).shape)
            self.canvas.draw_idle()
            QTimer.singleShot(200, lambda: self.status_label.setText(""))
            return True
        except Exception as exc:
            try:
                self._append_log(f"Cached frame render failed; rebuilding: {exc}", level='warning')
            except Exception:
                pass
            return False

    def _trim_plot_cache(self):
        try:
            max_items = max(1, int(self.plot_cache_size_spin.value())) if hasattr(self, 'plot_cache_size_spin') else self.plot_cache_max_items
            while len(self._plot_cache) > max_items:
                self._plot_cache.popitem(last=False)
        except Exception:
            pass

    def effective_display_resolution(self, requested_res):
        """Clamp interpolation resolution in interactive mode.

        This prevents an accidental very large interpolation grid from making
        the GUI unusable. The user can disable Auto downsample for full native
        display, but the default path remains interactive.
        """
        try:
            requested_res = int(requested_res)
            if hasattr(self, 'auto_downsample_toggle'):
                self.auto_downsample_enabled = bool(self.auto_downsample_toggle.isChecked())
            if hasattr(self, 'max_display_res_spin'):
                self.max_display_points = int(self.max_display_res_spin.value())
            if self.auto_downsample_enabled:
                return max(2, min(requested_res, int(self.max_display_points)))
            return requested_res
        except Exception:
            return requested_res

    def _array_stride(self, shape, max_points):
        try:
            if len(shape) < 2:
                return 1, 1
            ny, nx = int(shape[-2]), int(shape[-1])
            max_points = max(2, int(max_points))
            sy = max(1, int(np.ceil(ny / max_points)))
            sx = max(1, int(np.ceil(nx / max_points)))
            return sy, sx
        except Exception:
            return 1, 1

    def _slice_like_grid(self, arr, sy, sx, ref_shape):
        if arr is None:
            return None
        try:
            a = np.asarray(arr)
            if a.ndim >= 2 and tuple(a.shape[-2:]) == tuple(ref_shape[-2:]):
                return a[..., ::sy, ::sx]
            return arr
        except Exception:
            return arr

    def downsample_plot_bundle(self, X, Y, Z, vx=None, vy=None, vmag=None, max_points=None):
        """Downsample scalar/vector display arrays without changing physics data.

        The returned arrays are for visualization only. The original simulation
        output and all quantitative calculations remain untouched.
        """
        if hasattr(self, 'auto_downsample_toggle'):
            self.auto_downsample_enabled = bool(self.auto_downsample_toggle.isChecked())
        if not self.auto_downsample_enabled:
            return X, Y, Z, vx, vy, vmag
        if max_points is None:
            max_points = int(self.max_display_res_spin.value()) if hasattr(self, 'max_display_res_spin') else self.max_display_points
        try:
            Zarr = np.asarray(Z)
            if Zarr.ndim < 2:
                return X, Y, Z, vx, vy, vmag
            sy, sx = self._array_stride(Zarr.shape, max_points)
            if sy == 1 and sx == 1:
                return X, Y, Z, vx, vy, vmag
            ref_shape = Zarr.shape
            Xd = self._slice_like_grid(X, sy, sx, ref_shape)
            Yd = self._slice_like_grid(Y, sy, sx, ref_shape)
            Zd = Zarr[..., ::sy, ::sx]
            vxd = self._slice_like_grid(vx, sy, sx, ref_shape)
            vyd = self._slice_like_grid(vy, sy, sx, ref_shape)
            vmd = self._slice_like_grid(vmag, sy, sx, ref_shape)
            return Xd, Yd, Zd, vxd, vyd, vmd
        except Exception:
            return X, Y, Z, vx, vy, vmag

    def downsample_vector_for_streamlines(self, X, Y, U, V, C=None, max_points=None):
        if max_points is None:
            max_points = int(self.stream_display_res_spin.value()) if hasattr(self, 'stream_display_res_spin') else self.max_stream_points
        try:
            Uarr = np.asarray(U)
            if Uarr.ndim < 2:
                return X, Y, U, V, C
            sy, sx = self._array_stride(Uarr.shape, max_points)
            if sy == 1 and sx == 1:
                return X, Y, U, V, C
            ref_shape = Uarr.shape
            return (
                self._slice_like_grid(X, sy, sx, ref_shape),
                self._slice_like_grid(Y, sy, sx, ref_shape),
                Uarr[..., ::sy, ::sx],
                np.asarray(V)[..., ::sy, ::sx] if V is not None and np.asarray(V).ndim >= 2 else V,
                np.asarray(C)[..., ::sy, ::sx] if C is not None and np.asarray(C).ndim >= 2 else C,
            )
        except Exception:
            return X, Y, U, V, C

    def reset_default_view(self):
        self._safe_call("Restore default view", self._restore_default_view_state)
        self._safe_call("Restore default view", self.plot_density)

    def show_sim_info(self):
        if self.sim is not None:
            dlg = SimInfoDialog(self.sim, self)
            dlg.exec_()

    def on_slice_type_change(self, text):
        self.slice_type = text
        if getattr(self, '_loading_simulation', False):
            return
        if self._is_polar_2d():
            self._append_log("Polar 2D simulations use radial/azimuthal bounds only.", level='warning')
            self.plot_density()
            return
        # When changing slice type, reset fields according to convention
        coord_system = getattr(self, 'coord_system', 'spherical')
        
        if self.slice_type in ["theta", "z"]:
            # Constant theta (spherical) or constant z (cylindrical)
            if coord_system == 'cylindrical':
                # For cylindrical, default z=0
                z_val = self._format_angle(0.0)
                self.theta_min.setText(z_val)
            else:
                # For spherical, default theta=max
                theta_domain = getattr(self.sim.domains, 'theta', None)
                if theta_domain is not None:
                    theta_val = self._format_angle(theta_domain.max())
                    self.theta_min.setText(theta_val)
                else:
                    self.theta_min.setText("")
            self.theta_max.setText('')
            self.phi_min.setText("")
            self.phi_max.setText("")
        else:  # phi slice
            zero = self._format_angle(0.0)
            self.phi_min.setText(zero)
            self.phi_max.setText(zero)
            self.theta_min.setText("")
            self.theta_max.setText("")
        self.r_min.setText("")
        self.r_max.setText("")
        self.last_slice_str = ""  # <-- Ensure previous slice is cleared
        # Reset fixed colorbar limits when changing slice type
        self.fixed_cbar_limits = {}
        # Recalculate limits if fixed colorbar is enabled
        if self.fixed_cbar_enabled:
            self.update_fixed_cbar_limits()
        self.plot_density()

    def _minimal_periodic_phi_interval(self, phi_values, unwrap_output=True):
        """Return the smallest periodic interval containing the given phi values.

        The zoom box is defined in Cartesian coordinates, but native FARGO3D
        slices use phi.  A rectangular zoom that crosses the branch cut at
        +/-pi produces corner angles on both sides of the arctan2 discontinuity.
        A naive min/max over those angles selects the complement of the intended
        region.

        If unwrap_output is True and the minimal interval crosses the branch cut,
        the upper limit is returned as hi + 2*pi.  This keeps the interval ordered
        for FARGOpy's slice parser while still encoding the wrapped phi range.
        Example: [2.6, -2.6] is returned as [2.6, 3.683...] instead of
        [-2.6, 2.6].
        """
        phi_values = np.asarray(phi_values, dtype=float)
        phi_values = phi_values[np.isfinite(phi_values)]
        if phi_values.size == 0:
            return 0.0, 0.0

        period = 2.0 * np.pi
        try:
            phi_axis = np.asarray(self.sim.domains.phi, dtype=float)
            base = float(np.nanmin(phi_axis)) if phi_axis.size else -np.pi
        except Exception:
            base = -np.pi

        # Put all angles on the same branch as the simulation phi domain.
        phi = ((phi_values - base) % period) + base
        phi = np.sort(phi)

        if phi.size == 1:
            return float(phi[0]), float(phi[0])

        # The smallest enclosing arc is the complement of the largest gap.
        extended = np.concatenate([phi, [phi[0] + period]])
        gaps = np.diff(extended)
        gap_index = int(np.argmax(gaps))

        lo = float(phi[(gap_index + 1) % phi.size])
        hi = float(phi[gap_index])

        # If lo > hi, the interval crosses the periodic seam.  Returning hi+2*pi
        # preserves an ordered range and lets the lower FARGOpy periodic selector
        # reconstruct the wrapped selection correctly.
        if unwrap_output and lo > hi:
            hi += period

        return lo, hi

    def on_zoom_release(self, event):
        # Only if user used zoom (right button or wheel)
        if event.button not in [1, 3]:
            return
        ax = self.figure.gca()
        xlim = ax.get_xlim()
        ylim = ax.get_ylim()
        scale_factor, _, _, _ = self._length_scale_info()
        if not self.sim or not scale_factor:
            return
        x_min_plot, x_max_plot = xlim
        y_min_plot, y_max_plot = ylim
        to_ul = scale_factor / self.sim.UL
        x_min_ul = x_min_plot * to_ul
        x_max_ul = x_max_plot * to_ul
        y_min_ul = y_min_plot * to_ul
        y_max_ul = y_max_plot * to_ul

        corners = [
            (x_min_ul, y_min_ul),
            (x_min_ul, y_max_ul),
            (x_max_ul, y_min_ul),
            (x_max_ul, y_max_ul)
        ]

        if self._is_polar_2d():
            r_list = []
            phi_list = []

            for x, y in corners:
                r_list.append(np.sqrt(x**2 + y**2))
                phi_list.append(np.arctan2(y, x))

            r_min = np.min(r_list)
            r_max = np.max(r_list)
            phi_min, phi_max = self._minimal_periodic_phi_interval(phi_list)

            self.r_min.setText(self._sim_length_to_display(r_min))
            self.r_max.setText(self._sim_length_to_display(r_max))
            self.phi_min.setText(self._format_angle(phi_min))
            self.phi_max.setText(self._format_angle(phi_max))
            self.theta_min.setText("")
            self.theta_max.setText("")

            slice_str = (
                f"r=[{r_min:.3f},{r_max:.3f}],"
                f"phi=[{phi_min:.3f},{phi_max:.3f}]"
            )
            self.last_slice_str = slice_str
            self._fields_edited = False

            if self.fixed_cbar_enabled:
                self.update_fixed_cbar_limits()
            return

        coord_system = getattr(self, 'coord_system', 'spherical')
        r_list = []
        theta_list = []  # or z_list for cylindrical
        phi_list = []
        
        for x, y in corners:
            if self.slice_type in ["theta", "z"]:
                # Constant theta (spherical) or constant z (cylindrical)
                if coord_system == 'cylindrical':
                    # XY plane, z is constant
                    r = np.sqrt(x**2 + y**2)
                    z = 0.0  # Will be set from UI
                    phi = np.arctan2(y, x)
                    theta_list.append(z)  # Using theta_list to store z values
                else:
                    # Spherical XY plane
                    z = 0.0
                    r = np.sqrt(x**2 + y**2 + z**2)
                    theta = np.arccos(z / r) if r != 0 else 0.0
                    phi = np.arctan2(y, x)
                    theta_list.append(theta)
            else:  # phi slice
                if coord_system == 'cylindrical':
                    # RZ plane
                    r = x
                    z = y
                    phi = 0.0  # Will be set from UI
                    theta_list.append(z)
                else:
                    # Spherical RZ plane
                    y_ = 0.0
                    z = y
                    r = np.sqrt(x**2 + y_**2 + z**2)
                    theta = np.arccos(z / r) if r != 0 else 0.0
                    phi = np.arctan2(y_, x)
                    theta_list.append(theta)
            r_list.append(r)
            phi_list.append(phi)

        r_min = np.min(r_list)
        r_max = np.max(r_list)
        theta_min = np.min(theta_list)
        theta_max = np.max(theta_list)
        phi_min, phi_max = self._minimal_periodic_phi_interval(phi_list)
        
        # Determine coordinate name
        theta_coord_name = 'z' if coord_system == 'cylindrical' else 'theta'

        if self.slice_type in ["theta", "z"]:
            # Constant theta or z slice
            if coord_system == 'cylindrical':
                theta_val = self._format_angle(0.0)  # Default z=0
            else:
                    theta_domain = getattr(self.sim.domains, 'theta', None)
                    theta_val = self._format_angle(theta_domain.max()) if theta_domain is not None else ""
            self.theta_min.setText(theta_val)
            self.theta_max.setText(theta_val)
            self.r_min.setText(self._sim_length_to_display(r_min))
            self.r_max.setText(self._sim_length_to_display(r_max))
            self.phi_min.setText(self._format_angle(phi_min))
            self.phi_max.setText(self._format_angle(phi_max))
            slice_str = (
                f"{theta_coord_name}={theta_val},"
                f"r=[{r_min:.3f},{r_max:.3f}],"
                f"phi=[{phi_min:.3f},{phi_max:.3f}]"
            )
        else:
            # phi slice - keep phi fixed, update r range only
            phi_val = self.phi_min.text() if self.phi_min.text() != "" else self._format_angle(0.0)
            self.phi_min.setText(phi_val)
            self.phi_max.setText(phi_val)
            self.r_min.setText(self._sim_length_to_display(r_min))
            self.r_max.setText(self._sim_length_to_display(r_max))
            # Keep theta/z range but don't set it in UI to avoid confusion
            # The slice should be: phi=const, r=[min,max], theta/z=[min,max]
            slice_str = (
                f"phi={phi_val},"
                f"r=[{r_min:.3f},{r_max:.3f}],"
                f"{theta_coord_name}=[{theta_min:.3f},{theta_max:.3f}]"
            )
        self.last_slice_str = slice_str
        self._fields_edited = False
        
        # Recalculate fixed colorbar limits if enabled (fix colorbar bug in phi slices)
        if self.fixed_cbar_enabled:
            self.update_fixed_cbar_limits()
        
        # DO NOT call self.plot_density() here

    def build_slice_str(self):
        if self._is_polar_2d():
            return self._manual_polar_slice_str()
        # If the user edited any field manually SINCE the last update, ignore last_slice_str
        if getattr(self, "_fields_edited", False):
            return self._manual_slice_str()
        # Otherwise, use the zoom slice if present
        if self.last_slice_str:
            return self.last_slice_str
        return self._manual_slice_str()

    def _manual_polar_slice_str(self):
        def norm_angle(txt):
            try:
                return self._normalize_numeric_text(txt)
            except ValueError:
                return str(txt).replace(',', '.').strip()

        r_min_val = self._length_input_to_sim_units(str(self.r_min.text()).strip())
        r_max_val = self._length_input_to_sim_units(str(self.r_max.text()).strip())
        phi_min_val = norm_angle(self.phi_min.text())
        phi_max_val = norm_angle(self.phi_max.text())

        slice_parts = []
        if r_min_val and r_max_val:
            if abs(float(r_min_val) - float(r_max_val)) < 1e-10:
                slice_parts.append(f"r={r_min_val}")
            else:
                slice_parts.append(f"r=[{r_min_val},{r_max_val}]")
        elif r_min_val:
            slice_parts.append(f"r={r_min_val}")
        elif r_max_val:
            slice_parts.append(f"r={r_max_val}")

        if phi_min_val and phi_max_val:
            if abs(float(phi_min_val) - float(phi_max_val)) < 1e-10:
                slice_parts.append(f"phi={phi_min_val}")
            else:
                slice_parts.append(f"phi=[{phi_min_val},{phi_max_val}]")
        elif phi_min_val:
            slice_parts.append(f"phi={phi_min_val}")
        elif phi_max_val:
            slice_parts.append(f"phi={phi_max_val}")

        return ",".join(slice_parts)

    def _manual_slice_str(self):
        def norm_number(txt):
            try:
                return self._normalize_numeric_text(txt)
            except ValueError:
                return str(txt).replace(',', '.').strip()
        
        def values_equal(val1, val2):
            """Compare two numeric string values with tolerance."""
            if not val1 or not val2:
                return False
            try:
                return abs(float(val1) - float(val2)) < 1e-10
            except ValueError:
                return val1 == val2
        
        # Determine coordinate name for theta/z based on coordinate system
        coord_system = getattr(self, 'coord_system', 'spherical')
        theta_coord_name = 'z' if coord_system == 'cylindrical' else 'theta'

        r_min_val = self._length_input_to_sim_units(str(self.r_min.text()).strip())
        r_max_val = self._length_input_to_sim_units(str(self.r_max.text()).strip())
        if coord_system == 'cylindrical':
            theta_min_val = self._length_input_to_sim_units(str(self.theta_min.text()).strip())
            theta_max_val = self._length_input_to_sim_units(str(self.theta_max.text()).strip())
        else:
            theta_min_val = norm_number(self.theta_min.text())
            theta_max_val = norm_number(self.theta_max.text())
        phi_min_val = norm_number(self.phi_min.text())
        phi_max_val = norm_number(self.phi_max.text())
        

        slice_parts = []
        # Determine slice type based on which coordinate is fixed
        # Priority: phi > theta/z (if both phi_min==phi_max, it's a phi slice)
        is_phi_slice = phi_min_val and phi_max_val and values_equal(phi_min_val, phi_max_val)
        is_theta_slice = theta_min_val and (not theta_max_val or values_equal(theta_min_val, theta_max_val))
        
        # If both r_min and r_max are empty, and both phi_min and phi_max are empty, and theta is set, treat as a theta/z slice
        if not r_min_val and not r_max_val and not phi_min_val and not phi_max_val and theta_min_val:
            slice_parts.append(f"{theta_coord_name}={theta_min_val}")
        else:
            # Handle r coordinate
            if r_min_val and r_max_val:
                if values_equal(r_min_val, r_max_val):
                    slice_parts.append(f"r={r_min_val}")
                else:
                    slice_parts.append(f"r=[{r_min_val},{r_max_val}]")
            elif r_min_val:
                slice_parts.append(f"r={r_min_val}")
            elif r_max_val:
                slice_parts.append(f"r={r_max_val}")
            
            # Handle phi coordinate (check first to determine slice type)
            if phi_min_val and phi_max_val:
                if values_equal(phi_min_val, phi_max_val):
                    slice_parts.append(f"phi={phi_min_val}")
                    # For phi slice, add theta/z range if available
                    if theta_min_val and theta_max_val and not values_equal(theta_min_val, theta_max_val):
                        slice_parts.append(f"{theta_coord_name}=[{theta_min_val},{theta_max_val}]")
                else:
                    slice_parts.append(f"phi=[{phi_min_val},{phi_max_val}]")
            elif phi_min_val:
                slice_parts.append(f"phi={phi_min_val}")
            elif phi_max_val:
                slice_parts.append(f"phi={phi_max_val}")
            
            # Handle theta/z coordinate only if not a phi slice with range
            if not is_phi_slice:
                if theta_min_val and theta_max_val:
                    if values_equal(theta_min_val, theta_max_val):
                        slice_parts.append(f"{theta_coord_name}={theta_min_val}")
                    else:
                        slice_parts.append(f"{theta_coord_name}=[{theta_min_val},{theta_max_val}]")
                elif theta_min_val:
                    slice_parts.append(f"{theta_coord_name}={theta_min_val}")
                elif theta_max_val:
                    slice_parts.append(f"{theta_coord_name}={theta_max_val}")
        
        return ",".join(slice_parts)

    def on_slice_change(self):
        # Mark that a manual edit occurred and clear the zoom slice
        self._fields_edited = True
        self.last_slice_str = ""

    def update_plot(self):
        # Call only from the Update plot button
        self._fields_edited = False  # Reset flag; manual fields are the source of truth
        self.last_slice_str = ""     # Always use manual fields after updating
        self.plot_density()

    def on_map_change(self, text):
        try:
            field_type = self.available_field_catalog().get(text)
            self.vel_dropdown.setEnabled(field_type == 'vector')
        except Exception:
            self.vel_dropdown.setEnabled(False)

    def on_fixed_cbar_toggle(self, state):
        # Notify parent to update fixed colorbar limits if enabled
        if self.parent.fixed_cbar_enabled:
            self.parent.update_fixed_cbar_limits()
        self.parent.plot_density()

    def on_fixed_cbar_snap_change(self, value):
        if self.fixed_cbar_enabled:
            self.update_fixed_cbar_limits()
            self.plot_density()

    def update_fixed_cbar_limits(self):
        slice_str = self.build_slice_str()
        slice_arg = slice_str if str(slice_str).strip() else None
        requested_res = int(self.res_slider.value())
        res = self.effective_display_resolution(requested_res)
        vel_comp = self.vel_dropdown.currentText() if hasattr(self, 'vel_dropdown') else 'vx'
        snap = self.fixed_cbar_snap_spin.value()
        selected_field = self.selected_field_name()
        field_catalog = self.available_field_catalog(snapshot=snap)
        selected_field_type = field_catalog.get(selected_field)
        load_coords = 'cartesian'

        # The fixed colorbar must be associated with the actual output field
        # selected by the user, e.g. gasdens, dust1dens, gasenergy, gasv, etc.
        # Do not use a hard-coded MAP_TYPES list here.
        if not selected_field:
            return

        limit_key = selected_field

        def is_fixed(var, slice_str):
            if not slice_str:
                return False
            slice_clean = slice_str.replace(' ', '')
            single_match = re.search(rf'{var}=([^\[\],]+)', slice_clean)
            if single_match:
                return True
            range_match = re.search(rf'{var}=\[([^,]+),([^\]]+)\]', slice_clean)
            if range_match:
                try:
                    val1, val2 = float(range_match.group(1)), float(range_match.group(2))
                    return abs(val1 - val2) < 1e-10
                except ValueError:
                    return False
            return False

        polar_native = self._is_polar_2d()

        if polar_native:
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            use_var3 = False
        elif is_fixed('theta', slice_str) or is_fixed('z', slice_str):
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            use_var3 = False
        elif is_fixed('phi', slice_str):
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var3_mesh'
            use_var3 = True
        else:
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            use_var3 = False

        try:
            field_data = self.sim.load_field(
                fields=selected_field,
                slice=slice_arg,
                snapshot=snap,
                coords=load_coords
            )

            if hasattr(field_data, 'evaluate'):
                xmin = getattr(field_data, mesh_x_name)[0].min()
                xmax = getattr(field_data, mesh_x_name)[0].max()
                ymin = getattr(field_data, mesh_y_name)[0].min()
                ymax = getattr(field_data, mesh_y_name)[0].max()
                xs = np.linspace(xmin, xmax, res)
                ys = np.linspace(ymin, ymax, res)
                X, Y = np.meshgrid(xs, ys)

                if selected_field_type == 'vector':
                    if use_var3:
                        values = field_data.evaluate(field=selected_field, time=snap, var1=X, var3=Y, coords=load_coords)
                    else:
                        values = field_data.evaluate(field=selected_field, time=snap, var1=X, var2=Y, coords=load_coords)
                    idx = VEL_INDEX.get(vel_comp, 0)
                    v_factor = self.sim.UL / self.sim.UT
                    sim_unitsys = getattr(self.sim, "unitsystem", "cgs").lower()
                    denom = 1e5 if sim_unitsys == "cgs" else 1e3
                    data_map = (values[idx] * v_factor) / denom
                else:
                    if use_var3:
                        values = field_data.evaluate(field=selected_field, time=snap, var1=X, var3=Y, coords=load_coords)
                    else:
                        values = field_data.evaluate(field=selected_field, time=snap, var1=X, var2=Y, coords=load_coords)
                    data_map = self._scalar_cgs_log10(values, selected_field)
            else:
                mesh_attr = f'{selected_field}_mesh'
                if not hasattr(field_data, mesh_attr):
                    self.fixed_cbar_limits[limit_key] = None
                    return
                values = getattr(field_data, mesh_attr)[0]

                if selected_field_type == 'vector':
                    idx = VEL_INDEX.get(vel_comp, 0)
                    v_factor = self.sim.UL / self.sim.UT
                    sim_unitsys = getattr(self.sim, "unitsystem", "cgs").lower()
                    denom = 1e5 if sim_unitsys == "cgs" else 1e3
                    data_map = (values[idx] * v_factor) / denom
                else:
                    data_map = self._scalar_cgs_log10(values, selected_field)

            valid = np.isfinite(data_map)
            if np.any(valid):
                self.fixed_cbar_limits[limit_key] = (float(np.nanmin(data_map)), float(np.nanmax(data_map)))
            else:
                self.fixed_cbar_limits[limit_key] = None

        except Exception as exc:
            self.fixed_cbar_limits[limit_key] = None
            try:
                self._append_log(f"Could not compute fixed colorbar limits for {selected_field}: {exc}", level='error')
            except Exception:
                pass

    def _plot_reflection_overlay(self, ax, X_plot, Y_plot, data_map, cmap, vmin, vmax,
                                 show_streamlines, stream_density, stream_cmap,
                                 vx_plot, vy_plot, vmag_kms, skip_coord_reflect=False):
        """Draw the reflected scalar map and, when enabled, its reflected streamlines.

        The previous implementation returned immediately after pcolormesh(), so
        the reflected streamline block was unreachable. Keep the pcolormesh
        return value, but return it only after attempting streamlines.
        """
        if data_map is None:
            return None

        axis = getattr(self, "reflect_axis", "X-axis")

        if skip_coord_reflect:
            X_ref, Y_ref = X_plot, Y_plot
        else:
            X_ref, Y_ref = self._reflect_coordinates(axis, X_plot, Y_plot)

        pcm_overlay = ax.pcolormesh(
            X_ref,
            Y_ref,
            data_map,
            shading='auto',
            cmap=cmap,
            vmin=vmin,
            vmax=vmax,
        )

        if show_streamlines and vx_plot is not None and vy_plot is not None:
            if skip_coord_reflect:
                vx_ref, vy_ref = vx_plot, vy_plot
            else:
                vx_ref, vy_ref = self._reflect_vectors(axis, vx_plot, vy_plot)

            # Matplotlib streamplot requires monotonic grid axes. Reflection can
            # reverse one axis, so sort the grid and reorder velocity/color arrays
            # consistently before drawing.
            def _ensure_monotonic(X, Y, U=None, V=None, vm=None):
                try:
                    X = np.asarray(X)
                    Y = np.asarray(Y)
                    if X.ndim == 2 and Y.ndim == 2:
                        x_row = X[0, :]
                        y_col = Y[:, 0]

                        ix = None
                        iy = None

                        if not np.all(np.diff(x_row) > 0):
                            ix = np.argsort(x_row)
                        if not np.all(np.diff(y_col) > 0):
                            iy = np.argsort(y_col)

                        if ix is None and iy is None:
                            return X, Y, U, V, vm

                        if ix is None:
                            ix = np.arange(X.shape[1])
                        if iy is None:
                            iy = np.arange(X.shape[0])

                        X2 = X[np.ix_(iy, ix)]
                        Y2 = Y[np.ix_(iy, ix)]

                        U2 = U
                        V2 = V
                        vm2 = vm

                        if U is not None:
                            U_arr = np.asarray(U)
                            if U_arr.ndim == 2 and U_arr.shape == X.shape:
                                U2 = U_arr[np.ix_(iy, ix)]
                        if V is not None:
                            V_arr = np.asarray(V)
                            if V_arr.ndim == 2 and V_arr.shape == X.shape:
                                V2 = V_arr[np.ix_(iy, ix)]
                        if vm is not None:
                            vm_arr = np.asarray(vm)
                            if vm_arr.ndim == 2 and vm_arr.shape == X.shape:
                                vm2 = vm_arr[np.ix_(iy, ix)]

                        return X2, Y2, U2, V2, vm2
                except Exception:
                    pass

                return X, Y, U, V, vm

            try:
                Xr, Yr, vxr, vyr, vmr = _ensure_monotonic(
                    X_ref,
                    Y_ref,
                    vx_ref,
                    vy_ref,
                    vmag_kms,
                )

                # Reuse the same downsampling path as the primary streamlines if
                # available. This preserves performance and avoids visually denser
                # streamlines in the reflected half.
                try:
                    Xr, Yr, vxr, vyr, vmr = self.downsample_vector_for_streamlines(
                        Xr,
                        Yr,
                        vxr,
                        vyr,
                        vmr,
                    )
                except Exception:
                    pass

                ax.streamplot(
                    Xr,
                    Yr,
                    vxr,
                    vyr,
                    color=vmr if vmr is not None else None,
                    linewidth=0.45,
                    density=stream_density,
                    cmap=stream_cmap,
                    arrowsize=getattr(self, "stream_arrow_size", 1.0),
                )

            except Exception as exc:
                try:
                    self._append_log(
                        f"Could not draw reflected streamlines: {exc}",
                        level='error',
                    )
                except Exception:
                    pass

        return pcm_overlay

    def plot_density(self, unitsys_override=None):
        if getattr(self, '_loading_simulation', False):
            return
        return self._safe_call("Plot update", self._plot_density_impl, unitsys_override)

    def _plot_density_impl(self, unitsys_override=None):
        if not self.sim:
            return

        self.status_label.setText("🐍 The Python snake is exploring the disk...")
        QApplication.processEvents()

        slice_str = self.build_slice_str()
        slice_arg = slice_str if str(slice_str).strip() else None
        requested_res = int(self.res_slider.value())
        interpolate = self.interp_toggle.isChecked()
        res = self.effective_display_resolution(requested_res) if interpolate else requested_res
        show_streamlines = self.streamlines_toggle.isChecked()
        stream_density = self.density_slider.value()
        hill_frac = self.hill_frac_slider.value()
        show_circle = self.show_circle_toggle.isChecked()
        cmap = self.cmap_dropdown.currentText()
        stream_cmap = self.stream_cmap_dropdown.currentText()
        selected_field = self.selected_field_name()
        vel_comp = self.vel_dropdown.currentText()
        n = self.time_slider.value()
        field_catalog = self.available_field_catalog(snapshot=n)
        selected_field_type = field_catalog.get(selected_field)
        scalar_field_name = selected_field if selected_field and selected_field_type == 'scalar' else None
        vector_field_name = selected_field if selected_field and selected_field_type == 'vector' else None

        # Initialize helpers to avoid UnboundLocalError in error paths
        density_field = self._pick_field_by_type('scalar', selected_field, snapshot=n) or 'gasdens'
        energy_field = selected_field if self._is_energy_field(selected_field) else (self._pick_field_by_type('scalar', 'gasenergy', snapshot=n) or 'gasenergy')
        vector_field = self._pick_field_by_type('vector', selected_field, snapshot=n) if selected_field_type == 'vector' else None

        if not selected_field:
            self._append_log('No field selected.', level='warning')
            return

        if selected_field_type == 'vector':
            map_type = 'Velocity'
        elif self._is_energy_field(selected_field):
            map_type = 'Energy'
        else:
            map_type = 'Density'
        load_coords = 'cartesian'

        # --- UNITS ---
        sim_unitsys = getattr(self.sim, "unitsystem", "cgs").lower()
        length_unit = self.length_scale_combo.currentText()

        unit_factors = dict(_units_table(sim_unitsys, LENGTH_FACTORS))
        unit_factors["Simulation UL"] = self.sim.UL
        axis_unit_label_map = AXIS_UNIT_LABELS.get(sim_unitsys, AXIS_UNIT_LABELS["cgs"])

        scale_factor = unit_factors.get(length_unit, self.sim.UL)

        # Colorbar scalar fields are always converted to CGS.
        # Axis units can still be chosen independently through length_scale_combo.
        _, dens_unit, _ = self._density_cgs_info()
        _, energy_unit = self._energy_cgs_info()

        if sim_unitsys == "cgs":
            vel_unit = "cm/s"
            v_factor = self.sim.UL / self.sim.UT  # cm/s
        elif sim_unitsys == "mks":
            vel_unit = "m/s"
            v_factor = self.sim.UL / self.sim.UT  # m/s
        else:
            vel_unit = "UL/UT"
            v_factor = self.sim.UL / self.sim.UT
        # Determine axes and mesh names based on fixed coordinates
        def is_fixed(var, slice_str):
            if not slice_str:
                return False
            # Match both single values (var=X) and ranges with equal values (var=[X,X])
            slice_clean = str(slice_str).replace(' ', '')
            single_match = re.search(rf'{var}=([^\[\],]+)', slice_clean)
            if single_match:
                return True
            # Also check for ranges where min==max
            range_match = re.search(rf'{var}=\[([^,]+),([^\]]+)\]', slice_clean)
            if range_match:
                try:
                    val1, val2 = float(range_match.group(1)), float(range_match.group(2))
                    if abs(val1 - val2) < 1e-10:
                        return True
                except ValueError:
                    pass
            return False

        polar_native = self._is_polar_2d()

        # Assign canonical names used in this function
        density_field = selected_field if map_type == 'Density' else None
        energy_field = selected_field if map_type == 'Energy' else energy_field
        vector_field = selected_field if selected_field_type == 'vector' else None

        if map_type == 'Density' and density_field is None:
            self._append_log('The selected field is not a density-like scalar.', level='warning')
            return
        if map_type == 'Energy' and not self._is_energy_field(energy_field):
            self._append_log('The selected field is not an energy field.', level='warning')
            return
        if map_type == 'Velocity' and vector_field is None:
            self._append_log('The selected field is not vectorial.', level='warning')
            return

        # Check for theta (spherical) or z (cylindrical) being fixed
        if polar_native:
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            self._set_velocity_options(['vx', 'vy'])
        elif is_fixed('theta', slice_str) or is_fixed('z', slice_str):
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            self._set_velocity_options(['vx', 'vy'])
        elif is_fixed('phi', slice_str):
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var3_mesh'
            self._set_velocity_options(['vx', 'vz'])
        else:
            mesh_x_name = 'var1_mesh'
            mesh_y_name = 'var2_mesh'
            self._set_velocity_options(['vx', 'vy'])

        # Load data according to selection. Keep scalar and vector paths
        # separate: otherwise selecting dust1v/gasv leaves the vector object
        # undefined and triggers an UnboundLocalError.  The variable name gasv
        # is kept for backward compatibility with the rest of the plotting code,
        # but it may contain any vector field, e.g. gasv, dust1v, dust2v.
        load_coords = 'cartesian'
        data = None
        gasv = None
        gasenergy = None

        if map_type == 'Density':
            # If streamlines or vector evaluation is requested alongside a
            # scalar map, ensure the vector companion field is also loaded.
            fields_to_load = [density_field]
            if (show_streamlines or interpolate) and vector_field is None:
                vector_field = self._resolve_streamline_vector_field(density_field, snapshot=n)
            if vector_field is not None:
                fields_to_load.append(vector_field)

            data = self.sim.load_field(
                fields=fields_to_load,
                slice=slice_arg,
                snapshot=n,
                coords=load_coords
            )

        elif map_type == 'Velocity':
            gasv = self.sim.load_field(
                fields=vector_field,
                slice=slice_arg,
                snapshot=n,
                coords=load_coords
            )

        elif map_type == 'Energy':
            fields_to_load = [energy_field]
            if show_streamlines or interpolate:
                vector_field = self._resolve_streamline_vector_field(energy_field, snapshot=n)
                if vector_field is not None:
                    fields_to_load.append(vector_field)
            gasenergy = self.sim.load_field(
                fields=fields_to_load,
                slice=slice_arg,
                snapshot=n,
                coords=load_coords
            )

        # Select the object that provides the mesh arrays (used for xmin/xmax/ymin/ymax)
        if map_type == 'Density':
            mesh_source = data
        elif map_type == 'Velocity':
            mesh_source = gasv
        else:  # Energy
            mesh_source = gasenergy

        # --- Interpolation ---
        if interpolate:
            if mesh_y_name == 'var2_mesh':
                xmin, xmax = getattr(mesh_source, mesh_x_name)[0].min(), getattr(mesh_source, mesh_x_name)[0].max()
                ymin, ymax = getattr(mesh_source, mesh_y_name)[0].min(), getattr(mesh_source, mesh_y_name)[0].max()
                xs = np.linspace(xmin, xmax, res)
                ys = np.linspace(ymin, ymax, res)
                X, Y = np.meshgrid(xs, ys)
                if map_type == 'Density':
                    data_map = data.evaluate(field=density_field, time=n, var1=X, var2=Y, coords='cartesian')
                    data_map = self._scalar_cgs_log10(data_map, density_field)
                    if vector_field is not None:
                        vel = data.evaluate(field=vector_field, time=n, var1=X, var2=Y, coords='cartesian')
                        vx = vel[0]
                        vy = vel[1]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Energy':
                    data_map = gasenergy.evaluate(field=energy_field, time=n, var1=X, var2=Y, coords='cartesian')
                    data_map = self._scalar_cgs_log10(data_map, energy_field)
                    if vector_field is not None:
                        vel = gasenergy.evaluate(field=vector_field, time=n, var1=X, var2=Y, coords='cartesian')
                        vx = vel[0]
                        vy = vel[1]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Velocity':
                    vel = gasv.evaluate(time=n, var1=X, var2=Y, coords='cartesian')
                    idx = VEL_INDEX[vel_comp]
                    data_map = vel[idx]
                    vx = vel[0]
                    vy = vel[1]
                    vmag = np.sqrt(vx**2 + vy**2)
            else:
                xmin, xmax = getattr(mesh_source, mesh_x_name)[0].min(), getattr(mesh_source, mesh_x_name)[0].max()
                zmin, zmax = getattr(mesh_source, mesh_y_name)[0].min(), getattr(mesh_source, mesh_y_name)[0].max()
                xs = np.linspace(xmin, xmax, res)
                zs = np.linspace(zmin, zmax, res)
                X, Y = np.meshgrid(xs, zs)
                if map_type == 'Density':
                    data_map = data.evaluate(field=density_field, time=n, var1=X, var2=Y, coords='cartesian')
                    data_map = self._scalar_cgs_log10(data_map, density_field)
                    if vector_field is not None:
                        vel = data.evaluate(field=vector_field, time=n, var1=X, var2=Y, coords='cartesian')
                        vx = vel[0]
                        vy = vel[2]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Energy':
                    data_map = gasenergy.evaluate(field=energy_field, time=n, var1=X, var2=Y, coords='cartesian')
                    data_map = self._scalar_cgs_log10(data_map, energy_field)
                    if vector_field is not None:
                        vel = gasenergy.evaluate(field=vector_field, time=n, var1=X, var2=Y, coords='cartesian')
                        vx = vel[0]
                        vy = vel[2]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Velocity':
                    vel = gasv.evaluate(time=n, var1=X, var2=Y, coords='cartesian')
                    idx = VEL_INDEX[vel_comp]
                    data_map = vel[idx]
                    vx = vel[0]
                    vy = vel[2]
                    vmag = np.sqrt(vx**2 + vy**2)
        else:
            if mesh_y_name == 'var2_mesh':
                X = getattr(mesh_source, mesh_x_name)[0]
                Y = getattr(mesh_source, mesh_y_name)[0]
                if map_type == 'Density':
                    data_map = self._scalar_cgs_log10(getattr(data, f'{density_field}_mesh')[0], density_field)
                    if vector_field is not None:
                        vel = getattr(data, f'{vector_field}_mesh')[0]
                        vx = vel[0]
                        vy = vel[1]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Energy':
                    data_map = self._scalar_cgs_log10(getattr(gasenergy, f'{energy_field}_mesh')[0], energy_field)
                    if vector_field is not None:
                        vel = getattr(gasenergy, f'{vector_field}_mesh')[0]
                        vx = vel[0]
                        vy = vel[1]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Velocity':
                    vel = getattr(gasv, f'{vector_field}_mesh')[0]
                    idx = VEL_INDEX[vel_comp]
                    data_map = vel[idx]
                    vx = vel[0]
                    vy = vel[1]
                    vmag = np.sqrt(vx**2 + vy**2)
            else:
                X = getattr(mesh_source, mesh_x_name)[0]
                Y = getattr(mesh_source, mesh_y_name)[0]
                if map_type == 'Density':
                    data_map = self._scalar_cgs_log10(getattr(data, f'{density_field}_mesh')[0], density_field)
                    if vector_field is not None:
                        vel = getattr(data, f'{vector_field}_mesh')[0]
                        vx = vel[0]
                        vy = vel[2]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Energy':
                    data_map = self._scalar_cgs_log10(getattr(gasenergy, f'{energy_field}_mesh')[0], energy_field)
                    if vector_field is not None:
                        vel = getattr(gasenergy, f'{vector_field}_mesh')[0]
                        vx = vel[0]
                        vy = vel[2]
                        vmag = np.sqrt(vx**2 + vy**2)
                elif map_type == 'Velocity':
                    vel = getattr(gasv, f'{vector_field}_mesh')[0]
                    idx = {'vx': 0, 'vy': 1, 'vz': 2}[vel_comp]
                    data_map = vel[idx]
                    vx = vel[0]
                    vy = vel[2]
                    vmag = np.sqrt(vx**2 + vy**2)

        # --- Apply units and scaling to axes and velocity ---
        # X, Y are in simulation UL units. Convert to cm or m, then to target unit.
        X_plot = X * self.sim.UL / scale_factor
        Y_plot = Y * self.sim.UL / scale_factor

        # Convert velocities consistently:
        # - data returned by evaluate / meshes is in simulation velocity units (UL/UT).
        # - vx_phys, vy_phys, vmag_phys => physical units (cm/s for CGS, m/s for MKS)
        # - vx_plot, vy_plot => units matching X_plot/Y_plot (needed by streamplot)
        # - vmag_kms => km/s for colorbar (always)
        vx_phys = vy_phys = vmag_phys = None
        vx_plot = vy_plot = vmag_kms = None

        if map_type == 'Velocity':
            # data_map, vx, vy, vmag were set above (in sim units)
            try:
                vx_phys = vx * v_factor
                vy_phys = vy * v_factor
                vmag_phys = vmag * v_factor
            except Exception:
                vx_phys = vy_phys = vmag_phys = None

            # Convert physical velocities to plotting units (axis units per second)
            if vx_phys is not None and scale_factor is not None:
                vx_plot = vx_phys / scale_factor
            if vy_phys is not None and scale_factor is not None:
                vy_plot = vy_phys / scale_factor

            # Convert physical velocities to km/s for colorbar (always)
            if vmag_phys is not None:
                if sim_unitsys == "cgs":
                    denom = 1e5   # 1 km = 1e5 cm
                else:
                    denom = 1e3   # 1 km = 1e3 m
                vmag_kms = vmag_phys / denom

            # Also convert the scalar field used by pcolormesh (data_map) to km/s
            if 'data_map' in locals() and data_map is not None:
                try:
                    data_map = (data_map * v_factor) / (1e5 if sim_unitsys == "cgs" else 1e3)
                except Exception:
                    pass
        else:
            # For non-velocity maps, still prepare vmag_kms if streamlines requested
            if 'vmag' in locals() and vmag is not None:
                try:
                    vmag_phys = vmag * v_factor
                    denom = 1e5 if sim_unitsys == "cgs" else 1e3
                    vmag_kms = vmag_phys / denom
                    # streamline vector components must be in plot units for correct arrows:
                    if 'vx' in locals() and 'vy' in locals():
                        vx_plot = (vx * v_factor) / scale_factor
                        vy_plot = (vy * v_factor) / scale_factor
                except Exception:
                    vmag_kms = None

        # --- Masking and plotting ---
        # r in plot units (same as X_plot/Y_plot)
        r = np.sqrt(X_plot**2 + Y_plot**2)
        # Extract r_min/r_max from slice_str (these are in the original simulation units, no rescaling)
        r_match = re.search(r"r=\[([0-9\.]+),([0-9\.]+)\]", str(slice_str or "").replace(" ", ""))
        if r_match:
            # r_min_sim and r_max_sim are in simulation units (no rescaling)
            r_min_sim = float(r_match.group(1))
            r_max_sim = float(r_match.group(2))
            # Convert to plot units for masking
            r_min = r_min_sim * self.sim.UL / scale_factor
            r_max = r_max_sim * self.sim.UL / scale_factor
        else:
            r_min = None
            r_max = None

        # Mask using r in plot units
        if r_min is not None and r_max is not None:
            mask = (r >= r_min) & (r <= r_max)
            data_map = np.where(mask, data_map, np.nan)
            if show_streamlines and vx is not None and vy is not None and vmag is not None:
                vx = np.where(mask, vx, np.nan)
                vy = np.where(mask, vy, np.nan)
                vmag = np.where(mask, vmag, np.nan)

        X_plot = np.asarray(X_plot)
        Y_plot = np.asarray(Y_plot)
        data_map = np.asarray(data_map)

        # --- Level-of-detail for interactive display ---
        # Downsample only the arrays sent to Matplotlib. This keeps the GUI
        # responsive for very large outputs while preserving the simulation data.
        X_plot, Y_plot, data_map, vx_plot, vy_plot, vmag_kms = self.downsample_plot_bundle(
            X_plot, Y_plot, data_map, vx_plot, vy_plot, vmag_kms
        )
        X_plot = np.asarray(X_plot)
        Y_plot = np.asarray(Y_plot)
        data_map = np.asarray(data_map)

        # --- Set colorbar limits if fixed colorbar is enabled or manual vmin/vmax is enabled ---
        vmin = vmax = None
        if self.manual_vmin_vmax_enabled:
            vmin = self.manual_vmin
            vmax = self.manual_vmax
        elif self.fixed_cbar_enabled:
            limit_key = selected_field if selected_field else map_type
            limits = self.fixed_cbar_limits.get(limit_key)
            if limits is not None:
                vmin, vmax = limits

        # --- Fast playback path: update the existing QuadMesh when possible ---
        current_signature = self.plot_state_signature(slice_str=slice_arg)
        if self.can_use_fast_pcolormesh_update(current_signature, data_map):
            try:
                self._main_pcm.set_array(data_map.ravel())
                self._main_pcm.set_cmap(cmap)
                if vmin is not None and vmax is not None:
                    self._main_pcm.set_clim(vmin, vmax)
                elif not self.fixed_cbar_enabled and not self.manual_vmin_vmax_enabled:
                    valid = np.isfinite(data_map)
                    if np.any(valid):
                        self._main_pcm.set_clim(float(np.nanmin(data_map[valid])), float(np.nanmax(data_map[valid])))
                if getattr(self, '_main_cbar', None) is not None:
                    try:
                        self._main_cbar.update_normal(self._main_pcm)
                    except Exception:
                        pass
                self.canvas.draw_idle()
                QTimer.singleShot(200, lambda: self.status_label.setText(""))
                return
            except Exception as exc:
                print(f"Fast playback update failed; rebuilding plot: {exc}")

        self.figure.clear()
        ax = self.figure.add_subplot(111)
        ax.set_facecolor('white')
        self.figure.set_facecolor('white')

        # Defensive: ensure X_plot/Y_plot/data_map have compatible shapes
        X_plot = np.asarray(X_plot)
        Y_plot = np.asarray(Y_plot)
        data_map = np.asarray(data_map)
        pcm = None  # Initialize to None to ensure it's always defined
        try:
            pcm = ax.pcolormesh(X_plot, Y_plot, data_map, shading='auto', cmap=cmap, vmin=vmin, vmax=vmax)
        except ValueError:
            # Safer fallback: infer grid shape from data_map instead of
            # calling np.unique on potentially huge X/Y arrays.
            try:
                data_map2 = data_map
                # If data_map is 2D, prefer its shape
                if getattr(data_map, 'ndim', 1) == 2:
                    ny, nx = data_map.shape
                    # Extract coordinate vectors from the first row/col when possible
                    if getattr(X_plot, 'ndim', 1) == 2 and X_plot.shape[1] == nx:
                        xs = X_plot[0, :].copy()
                    else:
                        xs = np.linspace(np.nanmin(X_plot), np.nanmax(X_plot), nx)
                    if getattr(Y_plot, 'ndim', 1) == 2 and Y_plot.shape[0] == ny:
                        ys = Y_plot[:, 0].copy()
                    else:
                        ys = np.linspace(np.nanmin(Y_plot), np.nanmax(Y_plot), ny)
                    Xg, Yg = np.meshgrid(xs, ys)
                else:
                    # data_map is 1D/flat: reshape to near-square grid safely
                    size = data_map.size
                    nx = int(np.sqrt(size))
                    ny = int(np.ceil(size / nx))
                    if nx * ny != size:
                        data_map2 = np.full((ny, nx), np.nan)
                        data_map2.flat[:size] = data_map.flat
                    else:
                        data_map2 = data_map.reshape((ny, nx))
                    xs = np.linspace(np.nanmin(X_plot), np.nanmax(X_plot), nx)
                    ys = np.linspace(np.nanmin(Y_plot), np.nanmax(Y_plot), ny)
                    Xg, Yg = np.meshgrid(xs, ys)
                pcm = ax.pcolormesh(Xg, Yg, data_map2, shading='auto', cmap=cmap, vmin=vmin, vmax=vmax)
            except Exception as e:
                # If fallback fails, log error and continue without pcolormesh
                print(f"Warning: Could not create pcolormesh: {e}")
                pcm = None
        
        # --- Axis label according to scaling ---
        axis_unit_label = axis_unit_label_map.get(length_unit, length_unit)
        xlabel, ylabel = f'X [{axis_unit_label}]', f'Y [{axis_unit_label}]'

        stream_obj = None
        # Use vx_plot/vy_plot (axis-units per second) for streamplot so arrows scale correctly.
        if show_streamlines and vx_plot is not None and vy_plot is not None:
            # Ensure X_plot/Y_plot are acceptable for streamplot: rows of X
            # must be equal and columns of Y must be equal. If not, try to
            # reorder axes so they become monotonic grids (like meshgrid).
            def _sanitize_grid(X, Y, U=None, V=None, vm=None):
                try:
                    if getattr(X, 'ndim', 1) == 2 and getattr(Y, 'ndim', 1) == 2:
                        x_row = X[0, :]
                        y_col = Y[:, 0]
                        ix = None
                        iy = None
                        if not np.all(np.diff(x_row) > 0):
                            ix = np.argsort(x_row)
                        if not np.all(np.diff(y_col) > 0):
                            iy = np.argsort(y_col)
                        if ix is None and iy is None:
                            return X, Y, U, V, vm
                        if ix is None:
                            ix = np.arange(X.shape[1])
                        if iy is None:
                            iy = np.arange(X.shape[0])
                        X2 = X[np.ix_(iy, ix)]
                        Y2 = Y[np.ix_(iy, ix)]
                        U2 = U[np.ix_(iy, ix)] if U is not None else None
                        V2 = V[np.ix_(iy, ix)] if V is not None else None
                        vm2 = vm[np.ix_(iy, ix)] if vm is not None else None
                        return X2, Y2, U2, V2, vm2
                except Exception:
                    pass
                # Fallback: if X/Y are 1D or sanitization failed, try to
                # build a regular mesh from unique/mean coordinates.
                try:
                    if getattr(X, 'ndim', 1) == 2:
                        xs = np.mean(X, axis=0)
                    else:
                        xs = X
                    if getattr(Y, 'ndim', 1) == 2:
                        ys = np.mean(Y, axis=1)
                    else:
                        ys = Y
                    xs_sorted = np.sort(xs)
                    ys_sorted = np.sort(ys)
                    Xg, Yg = np.meshgrid(xs_sorted, ys_sorted)
                    # If U/V provided and shapes match, try to reorder using
                    # argsort indices derived from means; otherwise return mesh.
                    if U is not None and V is not None:
                        ix = np.argsort(xs)
                        iy = np.argsort(ys)
                        U2 = U[np.ix_(iy, ix)] if U.ndim == 2 else U
                        V2 = V[np.ix_(iy, ix)] if V.ndim == 2 else V
                        vm2 = vm[np.ix_(iy, ix)] if (vm is not None and vm.ndim == 2) else vm
                        return Xg, Yg, U2, V2, vm2
                    return Xg, Yg, U, V, vm
                except Exception:
                    return X, Y, U, V, vm

            Xs, Ys, vxs, vys, vms = _sanitize_grid(X_plot, Y_plot, vx_plot, vy_plot, vmag_kms)
            Xs, Ys, vxs, vys, vms = self.downsample_vector_for_streamlines(Xs, Ys, vxs, vys, vms)
            stream_obj = ax.streamplot(
                Xs, Ys, vxs, vys,
                color=vms if vms is not None else None,
                linewidth=0.5,
                density=stream_density,
                cmap=stream_cmap,
                arrowsize=getattr(self, "stream_arrow_size", 1.0)
            )

        if self.reflect_enabled:
            # Prefer using the FieldInterpolator's reflect augmentation
            # via evaluate(..., reflect=True) when available. For XZ
            # cuts (phi fixed) build a regular mesh using var1 (x)
            # and var3 (z) from the FieldInterpolator and set
            # zs = linspace(-zmax, zmin, res) as requested.
            try:
                # Use reflect via the FieldInterpolator only when we actually
                # interpolated the field (i.e. `interpolate` is True). If not
                # interpolating, keep the previous fallback behaviour.
                if interpolate and hasattr(mesh_source, 'evaluate') and is_fixed('phi', slice_str):
                    # Extract native mesh ranges (simulation units)
                    xvals = getattr(mesh_source, 'var1_mesh')[0]
                    zvals = getattr(mesh_source, 'var3_mesh')[0]
                    xmin, xmax = float(np.nanmin(xvals)), float(np.nanmax(xvals))
                    zmin, zmax = float(np.nanmin(zvals)), float(np.nanmax(zvals))

                    xs = np.linspace(xmin, xmax, res)
                    zs = np.linspace(-zmax, zmax, res)
                    V1, V3 = np.meshgrid(xs, zs)

                    # Interpolate reflected fields on that mesh depending on map type
                    try:
                        if map_type == 'Density':
                            data_map_ref = mesh_source.evaluate(field=density_field, time=n, var1=V1, var3=V3, reflect=True)
                            # Match main path: convert to log10 density in CGS units
                            data_map_ref = self._scalar_cgs_log10(data_map_ref, density_field)
                            # Also get velocity for streamlines
                            if vector_field is not None:
                                vel_ref = mesh_source.evaluate(field=vector_field, time=n, var1=V1, var3=V3, reflect=True)
                            else:
                                vel_ref = None
                        elif map_type == 'Energy':
                            data_map_ref = mesh_source.evaluate(field=energy_field, time=n, var1=V1, var3=V3, reflect=True)
                            data_map_ref = self._scalar_cgs_log10(data_map_ref, energy_field)
                            vel_ref = mesh_source.evaluate(field=vector_field, time=n, var1=V1, var3=V3, reflect=True) if vector_field is not None else None
                        else:  # Velocity
                            vel_ref = mesh_source.evaluate(field=vector_field, time=n, var1=V1, var3=V3, reflect=True)
                            idx_ref = VEL_INDEX.get(vel_comp, 0)
                            data_map_ref = vel_ref[idx_ref]

                        # Convert reflected mesh to plot units
                        Xr_plot = V1 * self.sim.UL / scale_factor
                        Yr_plot = V3 * self.sim.UL / scale_factor

                        # Convert velocities to plot units and compute vmr_kms as in main path
                        try:
                            if vel_ref is not None:
                                vxr_plot = (vel_ref[0] * v_factor) / scale_factor
                                vyr_plot = (vel_ref[2] * v_factor) / scale_factor
                            else:
                                vxr_plot = vyr_plot = None
                        except Exception:
                            vxr_plot = vyr_plot = None

                        try:
                            if vel_ref is not None:
                                vmag_phys_ref = np.sqrt((vel_ref[0] * v_factor)**2 + (vel_ref[2] * v_factor)**2)
                                denom = 1e5 if sim_unitsys == 'cgs' else 1e3
                                vmr_kms = vmag_phys_ref / denom
                            else:
                                vmr_kms = None
                        except Exception:
                            vmr_kms = None

                        # If map_type is Velocity, convert scalar field to km/s for coloring
                        if map_type == 'Velocity' and data_map_ref is not None:
                            try:
                                denom = 1e5 if sim_unitsys == 'cgs' else 1e3
                                data_map_ref = (data_map_ref * v_factor) / denom
                            except Exception:
                                pass

                        pcm_overlay = self._plot_reflection_overlay(
                            ax,
                            Xr_plot,
                            Yr_plot,
                            data_map_ref,
                            cmap,
                            vmin,
                            vmax,
                            show_streamlines,
                            stream_density,
                            stream_cmap,
                            vxr_plot,
                            vyr_plot,
                            vmr_kms,
                            skip_coord_reflect=True,
                        )
                        if pcm_overlay is not None:
                            pcm = pcm_overlay
                    except Exception:
                        # On any error fall back to default overlay
                        pcm_overlay = self._plot_reflection_overlay(
                            ax,
                            X_plot,
                            Y_plot,
                            data_map,
                            cmap,
                            vmin,
                            vmax,
                            show_streamlines,
                            stream_density,
                            stream_cmap,
                            vx_plot,
                            vy_plot,
                            vmag_kms,
                        )
                        if pcm_overlay is not None:
                            pcm = pcm_overlay
                else:
                    # Fallback to previous behaviour using already computed data_map
                    pcm_overlay = self._plot_reflection_overlay(
                        ax,
                        X_plot,
                        Y_plot,
                        data_map,
                        cmap,
                        vmin,
                        vmax,
                        show_streamlines,
                        stream_density,
                        stream_cmap,
                        vx_plot,
                        vy_plot,
                        vmag_kms,
                    )
                    if pcm_overlay is not None:
                        pcm = pcm_overlay
            except Exception:
                # On any error, fallback silently to previous behaviour
                pcm_overlay = self._plot_reflection_overlay(
                    ax,
                    X_plot,
                    Y_plot,
                    data_map,
                    cmap,
                    vmin,
                    vmax,
                    show_streamlines,
                    stream_density,
                    stream_cmap,
                    vx_plot,
                    vy_plot,
                    vmag_kms,
                )
                if pcm_overlay is not None:
                    pcm = pcm_overlay

        planets = self.sim.load_planets(snapshot=n)
        if planets:
            try:
                selected_data = self.hill_planet_combo.currentData()
                planet_index = int(selected_data) if selected_data is not None else int(self.hill_planet_combo.currentIndex())
            except Exception:
                planet_index = 0
            planet_index = max(0, min(planet_index, len(planets) - 1))
            planet = planets[planet_index]

            center_x = planet.pos.x * self.sim.UL / scale_factor
            center_y = planet.pos.y * self.sim.UL / scale_factor
            radius = hill_frac * planet.hill_radius * self.sim.UL / scale_factor
        else:
            center_x = 0
            center_y = 0
            radius = 0

        hill_color = getattr(self, "hill_color", "red")
        if show_circle and radius > 0:
            from matplotlib.patches import Circle
            if polar_native or is_fixed('theta', slice_str) or is_fixed('z', slice_str):
                circle = Circle(
                    (center_x, center_y),
                    radius,
                    color=hill_color,
                    fill=False,
                    linestyle='--',
                    linewidth=3,
                    label=fr'${hill_frac:.1f}\,R_H$'
                )
                ax.add_patch(circle)
            elif is_fixed('phi', slice_str):
                if getattr(self, 'reflect_enabled', False):
                    theta = np.linspace(0, 2 * np.pi, 200)
                else:
                    theta = np.linspace(0, np.pi, 100)
                x = center_x + radius * np.cos(theta)
                y = center_y + radius * np.sin(theta)
                ax.plot(x, y, color=hill_color, linewidth=3, label=fr'${hill_frac:.1f}\,R_H$', linestyle='--')

        # Change font and size of axis labels
        font_properties = {'fontsize': 15, 'fontname': 'Serif'}
        ax.set_xlabel(xlabel, **font_properties)
        ax.set_ylabel(ylabel, **font_properties)
        fp.Plot.fargopy_mark(ax)
        ax.legend(fontsize=15, prop={'family': 'Serif'}, loc='upper left')
        

        cbar = None

        # --- Colorbar label ---
        if show_streamlines and stream_obj is not None and vmag_kms is not None:
            cbar = self.figure.colorbar(stream_obj.lines, ax=ax)
            cbar.set_label('$|v|$ [km/s]', fontsize=15, fontname='Serif')
        else:
            if map_type == 'Density':
                cbar_label = self._scalar_cbar_label(density_field)
            elif map_type == 'Energy':
                cbar_label = self._scalar_cbar_label(energy_field)
            else:
                # Velocity maps use km/s for colorbar
                cbar_label = f'{vel_comp} [km/s]'

            # Create colorbar for the main pcolormesh when available
            if pcm is not None:
                try:
                    cbar = self.figure.colorbar(pcm, ax=ax)
                    # Slightly larger label for velocity
                    label_fontsize = 18 if map_type == 'Velocity' else 15
                    cbar.set_label(cbar_label, fontsize=label_fontsize, fontname='Serif')
                except Exception as e:
                    # If colorbar creation fails, log and continue
                    print(f"Warning: Could not create colorbar: {e}")
            else:
                # If pcm is None, create a ScalarMappable fallback so a
                # colorbar is still shown (useful when pcolormesh failed
                # due to irregular grids). Use the current cmap and vmin/vmax
                # when available.
                try:
                    cmap_obj = plt.cm.get_cmap(cmap) if cmap is not None else plt.cm.viridis
                    if vmin is None or vmax is None:
                        # Try infer vmin/vmax from data_map if possible
                        try:
                            valid = np.isfinite(data_map)
                            if np.any(valid):
                                vmin = float(np.nanmin(data_map[valid]))
                                vmax = float(np.nanmax(data_map[valid]))
                        except Exception:
                            pass
                    from matplotlib.cm import ScalarMappable
                    from matplotlib.colors import Normalize
                    norm = None
                    if vmin is not None and vmax is not None and vmin != vmax:
                        norm = Normalize(vmin=vmin, vmax=vmax)
                    mappable = ScalarMappable(norm=norm, cmap=cmap_obj)
                    mappable.set_array([])
                    cbar = self.figure.colorbar(mappable, ax=ax)
                    label_fontsize = 18 if map_type == 'Velocity' else 15
                    cbar.set_label(cbar_label, fontsize=label_fontsize, fontname='Serif')
                except Exception as e:
                    print(f"Warning: Could not create fallback colorbar: {e}")

        # Store references used by the fast playback path.
        self._main_pcm = pcm
        self._main_cbar = cbar
        self._last_plot_signature = current_signature
        self._last_data_shape = tuple(np.asarray(data_map).shape) if data_map is not None else None

        # Store simple display frames for smooth back/forward playback.
        # Complex overlays are excluded by _simple_plot_cache_allowed().
        try:
            if pcm is not None and self._simple_plot_cache_allowed():
                self._put_plot_cache(
                    self._plot_cache_key(current_signature, n),
                    {
                        'X': np.asarray(X_plot).copy(),
                        'Y': np.asarray(Y_plot).copy(),
                        'Z': np.asarray(data_map).copy(),
                        'cmap': cmap,
                        'vmin': vmin,
                        'vmax': vmax,
                        'xlabel': xlabel,
                        'ylabel': ylabel,
                        'cbar_label': cbar_label if 'cbar_label' in locals() else '',
                        'signature': current_signature,
                    }
                )
        except Exception:
            pass

        self.canvas.draw()
        QTimer.singleShot(800, lambda: self.status_label.setText(""))

    def show_plot_options_dialog(self):
        dlg = PlotOptionsDialog(self)
        dlg.exec_()

    def open_reflect_dialog(self):
        if not self.sim:
            return
        dlg = ReflectDialog(self, enabled=self.reflect_enabled, axis=self.reflect_axis)
        if dlg.exec_() == QDialog.Accepted:
            enabled, axis = dlg.values()
            self.reflect_enabled = enabled
            self.reflect_axis = axis
            self.plot_density()

    def open_video_options_dialog(self):
        if not self.sim:
            return
        nmax = self.sim._get_nsnaps() - 1
        dlg = VideoOptionsDialog(self, nmax=nmax)
        if dlg.exec_() == QDialog.Accepted:
            fps = dlg.fps_spin.value()
            bitrate = dlg.bitrate_spin.value()
            start_snap = dlg.start_snap_spin.value()
            end_snap = dlg.end_snap_spin.value()
            save_frames = getattr(dlg, 'save_frames_checkbox', None) and dlg.save_frames_checkbox.isChecked()
            self.create_video_with_options(fps, bitrate, start_snap, end_snap, save_frames=save_frames)

    def create_video_with_options(self, fps, bitrate, start_snap, end_snap, save_frames=False):
        from PyQt5.QtWidgets import QFileDialog, QMessageBox
        video_path, _ = QFileDialog.getSaveFileName(self, "Save video", "fargopy_video.mp4", "MP4 Files (*.mp4)")
        if not video_path:
            self.video_button.setEnabled(True)
            return

        original_snapshot = self.time_slider.value()
        fig = self.figure
        self.video_button.setEnabled(False)
        self._video_animating = True

        frames = list(range(start_snap, end_snap + 1))
        progress = RecordingProgressDialog(self)
        progress.show()
        QApplication.processEvents()

        writer = FFMpegWriter(fps=fps, metadata=dict(artist='FARGOpy'), bitrate=bitrate)
        frames_written = 0

        try:
            with writer.saving(fig, video_path, dpi=fig.dpi or 100):
                for snap in frames:
                    QApplication.processEvents()
                    if progress.stop_requested:
                        break
                    self.time_slider.blockSignals(True)
                    self.time_slider.setValue(snap)
                    self.time_slider.blockSignals(False)
                    self.plot_density()
                    # Optionally save the current frame as PNG
                    if save_frames:
                        try:
                            frames_dir = os.path.splitext(video_path)[0] + "_frames"
                            os.makedirs(frames_dir, exist_ok=True)
                            png_path = os.path.join(frames_dir, f"frame_{snap:05d}.png")
                            fig.savefig(png_path, dpi=fig.dpi or 100)
                        except Exception:
                            # If saving a frame fails, continue without stopping
                            pass
                    writer.grab_frame()
                    frames_written += 1
        except Exception as e:
            progress.close()
            QMessageBox.critical(self, "Error creating video", f"Could not create video:\n{e}")
            self.time_slider.setValue(original_snapshot)
            self.video_button.setEnabled(True)
            self._video_animating = False
            return
        finally:
            progress.close()

        self._video_animating = False
        self.time_slider.setValue(original_snapshot)
        self.video_button.setEnabled(True)

        if frames_written == 0:
            try:
                os.remove(video_path)
            except Exception:
                pass
            QMessageBox.warning(self, "Video not created", "Recording stopped before any frame was captured.")
            return

        try:
            if sys.platform.startswith('linux'):
                subprocess.Popen(['xdg-open', video_path])
            elif sys.platform.startswith('darwin'):
                subprocess.Popen(['open', video_path])
            elif sys.platform.startswith('win'):
                os.startfile(video_path)
        except Exception:
            pass

        msg = "Video saved successfully."
        if progress.stop_requested:
            msg += f"\nStopped early after {frames_written} frame(s)."
        QMessageBox.information(self, "Video created", f"{msg}\nPath:\n{video_path}")

if __name__ == "__main__":
    print("Starting GUI...")
    app = QApplication(sys.argv)
    window = PlotInteractiveWindow()
    sys.excepthook = window._qt_exception_hook
    window.setWindowTitle("FARGOpy Interactive Plot")
    window.resize(1620, 960)
    window.show()
    print("Window shown. Running app...")
    sys.exit(app.exec_())
