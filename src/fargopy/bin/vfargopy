        self.stream_cmap_dropdown.addItems(COLORMAPS)
        try:
            self.stream_cmap_dropdown.setCurrentText('viridis_r')
        except Exception:
            pass
        self.map_dropdown = QComboBox()
        self.map_dropdown.setEnabled(False)
