        self.slice_type = "theta"
        self.last_slice_str = ""

    def _is_polar_2d(self):
        return bool(
            self.sim
            and getattr(self.sim.vars, 'DIM', 3) == 2
            and getattr(self.sim.vars, 'COORDINATES', '').lower() == 'polar'
        )

    def _is_energy_field(self, field_name):
        """Return True for Fargo3D energy fields: gasenergy, dust1energy, etc."""
        return bool(field_name and str(field_name).strip().lower().endswith('energy'))

    def _density_cgs_info(self):
        """Return (factor, unit_label, symbol_label) for density-like scalar maps.

        Native 2D FARGO3D outputs store surface density, while 3D outputs
        and 3D slices store volumetric density.  The GUI colorbar is always
        expressed in CGS units, independently of the axis length unit.
        """
        if self._is_polar_2d():
            factor = getattr(self.sim, 'USIGMA', None)
            if factor is None:
                factor = self.sim.UM / self.sim.UL**2
            return float(factor), r'g cm$^{-2}$', r'\Sigma'

        factor = getattr(self.sim, 'URHO', None)
        if factor is None:
            factor = self.sim.UM / self.sim.UL**3
        return float(factor), r'g cm$^{-3}$', r'\rho'

    def _energy_cgs_info(self):
        """Return (factor, unit_label) for energy-like scalar maps.

        In native 2D, Fargo3D energy is a surface energy density with CGS
        units erg cm^-2. In 3D, it is a volumetric energy density with CGS
        units erg cm^-3.
        """
        if self._is_polar_2d():
            factor = self.sim.UM / self.sim.UT**2
            return float(factor), r'erg cm$^{-2}$'

        factor = getattr(self.sim, 'UEPS', None)
        if factor is None:
            factor = self.sim.UM / (self.sim.UL * self.sim.UT**2)
        return float(factor), r'erg cm$^{-3}$'

    def _scalar_cgs_log10(self, values, field_name):
        """Convert a scalar field to log10 CGS values for plotting."""
        if self._is_energy_field(field_name):
            factor, _ = self._energy_cgs_info()
        else:
            factor, _, _ = self._density_cgs_info()
        values_phys = np.asarray(values, dtype=float) * factor
        with np.errstate(divide='ignore', invalid='ignore'):
            return np.where(values_phys > 0, np.log10(values_phys), np.nan)

    def _scalar_cbar_label(self, field_name):
        """Return the colorbar label for scalar fields in CGS units."""
        if self._is_energy_field(field_name):
            _, unit = self._energy_cgs_info()
            return r'$\log_{10}(E)$' + f' [{unit}]'
        _, unit, symbol = self._density_cgs_info()
        return rf'$\log_{{10}}({symbol})$' + f' [{unit}]'

    def _append_log(self, message, level="info"):
        stamp = datetime.now().strftime("%H:%M:%S")
        text = f"[{stamp}] {message}"
        if hasattr(self, 'log_text'):
            color = {'error': '#ff6b6b', 'warning': '#ffb84d', 'info': '#d7d7d7'}.get(level, '#d7d7d7')
            self.log_text.append(f'<span style="color:{color};">{text}</span>')
            self.log_text.verticalScrollBar().setValue(self.log_text.verticalScrollBar().maximum())
        print(text)

    def _handle_exception(self, context, exc):
        message = f"{context}: {exc}"
        self._append_log(message, level='error')
        self.status_label.setText("Error: see log panel")

    def _safe_call(self, context, func, *args, **kwargs):
        try:
            return func(*args, **kwargs)
        except Exception as exc:
            self._handle_exception(context, exc)
            return None

    def _qt_exception_hook(self, exc_type, exc_value, exc_traceback):
        message = ''.join(traceback.format_exception(exc_type, exc_value, exc_traceback))
        self._append_log(message, level='error')
        self.status_label.setText("Unhandled error: see log panel")

    def _configure_coordinate_controls(self):
        coord_system = getattr(self, 'coord_system', 'spherical')

        if coord_system == 'polar':
            self.r_label.setText("Radial r:")
            self.theta_label.setText("Not used")
            self.phi_label.setText("Azimuthal φ:")
            self.theta_min.setEnabled(False)
            self.theta_max.setEnabled(False)
            self.slice_type_label.setText("2D polar")
            self.slice_type_combo.blockSignals(True)
            self.slice_type_combo.clear()
            self.slice_type_combo.addItems(['r', 'phi'])
            self.slice_type_combo.setEnabled(False)
            self.slice_type_combo.setCurrentText('phi')
            self.slice_type_combo.blockSignals(False)
            return

        self.theta_min.setEnabled(True)
        self.theta_max.setEnabled(True)

        if coord_system == 'cylindrical':
            self.r_label.setText("r:")
            self.theta_label.setText("z:")
            self.phi_label.setText("φ:")
            self.slice_type_label.setText("Slice type:")
            self.slice_type_combo.blockSignals(True)
            self.slice_type_combo.clear()
            self.slice_type_combo.addItems(['z', 'phi'])
            self.slice_type_combo.setEnabled(True)
            self.slice_type_combo.setCurrentText('z')
            self.slice_type_combo.blockSignals(False)
            return

        self.r_label.setText("r:")
        self.theta_label.setText("θ:")
        self.phi_label.setText("φ:")
        self.slice_type_label.setText("Slice type:")
        self.slice_type_combo.blockSignals(True)
        self.slice_type_combo.clear()
        self.slice_type_combo.addItems(['theta', 'phi'])
        self.slice_type_combo.setEnabled(True)
        self.slice_type_combo.setCurrentText('theta')
        self.slice_type_combo.blockSignals(False)

    def _set_velocity_options(self, components):
        """Only touch the velocity dropdown if the options actually change."""
        desired = list(components)
        current = [self.vel_dropdown.itemText(i) for i in range(self.vel_dropdown.count())]
        if current == desired:
            return
        self.vel_dropdown.blockSignals(True)
        self.vel_dropdown.clear()
        self.vel_dropdown.addItems(desired)
        self.vel_dropdown.blockSignals(False)

    def available_field_names(self):
        if not self.sim:
            return []
        try:
            snap = int(self.time_slider.value()) if hasattr(self, 'time_slider') else 0
            return list(self.sim.available_fields(snapshot=snap).keys())
        except Exception:
            return []

    def selected_field_name(self):
        if hasattr(self, 'map_dropdown') and self.map_dropdown.currentText().strip():
            return self.map_dropdown.currentText().strip()
        if hasattr(self, 'field_dropdown') and self.field_dropdown.currentText().strip():
            return self.field_dropdown.currentText().strip()
        fields = self.available_field_names()
        if 'gasdens' in fields:
            return 'gasdens'
        return fields[0] if fields else ''

    def available_field_catalog(self, snapshot=None):
        if not self.sim:
            return {}
        try:
            snap = int(self.time_slider.value()) if snapshot is None and hasattr(self, 'time_slider') else int(snapshot or 0)
            return dict(self.sim.available_fields(snapshot=snap))
        except Exception:
            return {}

    def _pick_field_by_type(self, field_type, selected_field=None, snapshot=None):
        catalog = self.available_field_catalog(snapshot=snapshot)
        if selected_field and catalog.get(selected_field) == field_type:
            return selected_field
        matches = sorted(name for name, ftype in catalog.items() if ftype == field_type)
        return matches[0] if matches else None

    def refresh_field_dropdown(self, preferred=None):
        fields = self.available_field_names()
        default = preferred
        current = self.field_dropdown.currentText().strip() if hasattr(self, 'field_dropdown') else None
        if default is None:
            default = current
        if preferred and preferred in fields:
            default = preferred
        elif default not in fields:
            default = 'gasdens' if 'gasdens' in fields else (fields[0] if fields else None)
        populate_field_combo(self.field_dropdown, fields, default)
        populate_field_combo(self.map_dropdown, fields, default)

    def _resolve_streamline_vector_field(self, field_name, snapshot=None):
        catalog = self.available_field_catalog(snapshot=snapshot)
        if not field_name or not catalog:
            return None
        if catalog.get(field_name) == 'vector':
            return field_name
        candidates = []
        if field_name.startswith('gasdens'):
            candidates.extend(['gasv', 'gasdensv'])
        if field_name.endswith('dens'):
            candidates.append(f"{field_name[:-4]}v")
        candidates.append(f"{field_name}v")
        trimmed = re.sub(r"(dens|density|rho|energy)$", "", field_name)
        if trimmed and trimmed != field_name:
            candidates.append(f"{trimmed}v")
        for candidate in candidates:
            if catalog.get(candidate) == 'vector':
                return candidate
        prefixes = [field_name, re.sub(r"\d+$", "", field_name)]
        for prefix in prefixes:
            for name, ftype in catalog.items():
                if ftype == 'vector' and name.startswith(prefix):
                    return name
        return None

    def _reflect_coordinates(self, axis, X, Y):
        if axis == "X-axis":
            return X, -Y
        if axis == "Y-axis":
            return -X, Y
        return -X, -Y  # Origin (both axes)

    def _reflect_vectors(self, axis, vx, vy):
        if axis == "X-axis":
            return vx, -vy
        if axis == "Y-axis":
            return -vx, vy
        return -vx, -vy

    def _length_scale_info(self):
        if not self.sim:
            return None, None, getattr(self, "length_scale_combo", None), "cgs"
        sim_unitsys = getattr(self.sim, "unitsystem", "cgs").lower()
        length_unit = self.length_scale_combo.currentText()
        unit_factors = dict(_units_table(sim_unitsys, LENGTH_FACTORS))
        unit_factors["Simulation UL"] = self.sim.UL
        scale_factor = unit_factors.get(length_unit, self.sim.UL)
        axis_labels = AXIS_UNIT_LABELS.get(sim_unitsys, AXIS_UNIT_LABELS["cgs"])
        axis_label = axis_labels.get(length_unit, length_unit)
        return scale_factor, axis_label, sim_unitsys, length_unit

    def _parse_numeric_input(self, value):
        """Parse GUI numeric input into a float.

        Accepted forms include ordinary floats, scientific notation, pi
        expressions and degree suffixes, e.g. ``pi/2``, ``2pi``, ``3*pi/2``,
        ``-2pi``, ``30 deg`` and ``40°``.  The return value is always in
        radians/natural numeric units; callers decide whether that number is an
        angle or a length in the active display units.
        """
        if value is None:
            raise ValueError("empty numeric input")

        text = (str(value).strip().lower()
                .replace(',', '.')
                .replace('np.pi', 'pi')
                .replace('π', 'pi')
                .replace('−', '-')
                .replace('–', '-')
                .replace('—', '-')
                .replace('×', '*'))
        if not text:
            raise ValueError("empty numeric input")

        # Degree inputs are converted first, recursively.
        deg_match = re.fullmatch(r"(.+?)\s*(?:deg|degree|degrees|°)", text)
        if deg_match:
            return float(np.deg2rad(self._parse_numeric_input(deg_match.group(1))))

        # Support compact pi notation: 2pi, -2pi, 3pi/2, (1+2)pi, etc.
        text = re.sub(r"(?<=[0-9\)])\s*pi\b", "*pi", text)
        text = re.sub(r"\bpi\s*(?=[0-9\(])", "pi*", text)

        allowed_names = {"pi": float(np.pi), "e": float(np.e)}
        allowed_nodes = (
            ast.Expression, ast.BinOp, ast.UnaryOp, ast.Add, ast.Sub,
            ast.Mult, ast.Div, ast.Pow, ast.Mod, ast.USub, ast.UAdd,
            ast.Constant, ast.Name, ast.Load,
        )

        def _eval(node):
            if not isinstance(node, allowed_nodes):
                raise ValueError(f"unsupported numeric input: {value}")
            if isinstance(node, ast.Expression):
                return _eval(node.body)
            if isinstance(node, ast.Constant):
                if isinstance(node.value, (int, float)):
                    return float(node.value)
                raise ValueError(f"unsupported numeric input: {value}")
            if isinstance(node, ast.Name):
                if node.id in allowed_names:
                    return allowed_names[node.id]
                raise ValueError(f"unsupported numeric input: {value}")
            if isinstance(node, ast.UnaryOp):
                operand = _eval(node.operand)
                if isinstance(node.op, ast.UAdd):
                    return +operand
                if isinstance(node.op, ast.USub):
                    return -operand
            if isinstance(node, ast.BinOp):
                left = _eval(node.left)
                right = _eval(node.right)
                if isinstance(node.op, ast.Add):
                    return left + right
                if isinstance(node.op, ast.Sub):
                    return left - right
                if isinstance(node.op, ast.Mult):
                    return left * right
                if isinstance(node.op, ast.Div):
                    return left / right
                if isinstance(node.op, ast.Pow):
                    return left ** right
                if isinstance(node.op, ast.Mod):
                    return left % right
            raise ValueError(f"unsupported numeric input: {value}")

        try:
            return float(_eval(ast.parse(text, mode="eval")))
        except Exception as exc:
            raise ValueError(f"Could not parse numeric input '{value}'") from exc

    def _normalize_numeric_text(self, value, empty_ok=True):
        """Return a canonical float string for a GUI numeric expression."""
        text = str(value).strip() if value is not None else ""
        if not text:
            return "" if empty_ok else text
        parsed = self._parse_numeric_input(text)
        return f"{parsed:.10g}"

    def _length_input_to_sim_units(self, value_str):
        if not value_str or not self.sim:
            return value_str
        try:
            value = self._parse_numeric_input(value_str)
        except ValueError:
            return value_str
        scale_factor, _, _, _ = self._length_scale_info()
        if not scale_factor:
            return f"{value:.10g}"
        converted = value * scale_factor / self.sim.UL
        return f"{converted:.10g}"

    def _sim_length_to_display(self, value):
        if value is None or not self.sim:
            return value
        scale_factor, _, _, _ = self._length_scale_info()
        if not scale_factor:
            return value
        display_val = value * self.sim.UL / scale_factor
        return f"{display_val:.3f}"

    def _format_angle(self, value):
        try:
            return f"{float(value):.3f}"
        except (TypeError, ValueError):
            return str(value) if value is not None else ""

    def init_ui(self):
        self.setFont(QFont("Segoe UI", 13))

        logo_label = QLabel()
        logo_path = None
        try:
            import pkg_resources
            candidate = pkg_resources.resource_filename('fargopy', 'data/fargopy_logo_white.png')
            if os.path.exists(candidate):
                logo_path = candidate
        except Exception:
            pass

        if logo_path is None:
            try:
                pkg_dir = os.path.dirname(fp.__file__)
                candidate = os.path.abspath(os.path.join(pkg_dir, '..', '..', 'gallery', 'fargopy_logo_white.png'))
                if os.path.exists(candidate):
                    logo_path = candidate
            except Exception:
                pass

        if logo_path is None:
            try:
                script_dir = os.path.dirname(__file__)
                candidate = os.path.abspath(os.path.join(script_dir, '..', '..', '..', '..', 'gallery', 'fargopy_logo_white.png'))
                if os.path.exists(candidate):
                    logo_path = candidate
            except Exception:
                pass

        logo_pixmap = QPixmap()
        try:
            if logo_path and os.path.exists(logo_path):
                logo_pixmap = QPixmap(logo_path)
        except Exception:
            logo_pixmap = QPixmap()

        if not logo_pixmap.isNull():
            logo_pixmap = logo_pixmap.scaledToWidth(260, Qt.SmoothTransformation)
            logo_label.setPixmap(logo_pixmap)
        else:
            logo_label.setText("FARGOpy")
            logo_label.setStyleSheet('color: white; font-weight: bold; font-size: 24px;')
        logo_label.setAlignment(Qt.AlignCenter)
        logo_label.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)

        def orange_button_style(font_size=14, padding="7px 12px"):
            return f"""
                QPushButton {{
                    background-color: #ff9800;
                    color: white;
                    font-size: {font_size}px;
                    font-weight: bold;
                    border-radius: 8px;
                    padding: {padding};
                }}
                QPushButton:hover {{
                    background-color: #e65100;
                }}
                QPushButton:disabled {{
                    color: #d0d0d0;
                    background-color: #6d6d6d;
                }}
            """

        def make_group(title):
            group = QGroupBox(title)
            layout = QGridLayout(group)
            layout.setHorizontalSpacing(10)
            layout.setVerticalSpacing(7)
            layout.setContentsMargins(10, 14, 10, 10)
            return group, layout

